{
  "manifest_version": 3,
  "name": "GoSeller – Respostas rápidas, abas e envios",
  "short_name": "GoSeller",
  "version": "0.8.3",
  "description": "Respostas rápidas, abas de leads, Kanban e campanhas com ritmo seguro para equipes de vendas no WhatsApp Web.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Abrir o GoSeller no WhatsApp Web",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://agents.coolmeia.tech/*",
    "https://*.goseller.app.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/config-wpp.js",
        "lib/wppconnect-wa.js",
        "src/pagina.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/comum.js",
        "src/waseller.js",
        "src/etapas.js",
        "src/conteudo.js"
      ],
      "css": [
        "src/layout.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}